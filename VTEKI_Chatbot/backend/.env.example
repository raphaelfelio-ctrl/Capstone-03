# Buat API key GRATIS di https://aistudio.google.com/apikey
GEMINI_API_KEY=isi_api_key_di_sini
# Model utama (cek daftar & kuota gratis di https://aistudio.google.com/rate-limit)
GEMINI_MODEL=gemini-2.5-flash
# Model cadangan, dipisah koma
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite
# Klasifikasi intent + deteksi manipulasi dengan Gemini (1 panggilan tambahan per pesan).
# Set false bila kuota gratis sering habis; guardrail berbasis pola tetap aktif.
LLM_CLASSIFIER=true

APP_SECRET=ganti_dengan_random_secret_minimal_32_karakter
DATABASE_PATH=./vteki.db

# Organisasi yang dilayani knowledge base (dipakai di sapaan & prompt AI)
ORG_NAME=BCA
ASSISTANT_NAME=Asisten AI V-TEKI

# Knowledge base
KNOWLEDGE_DIR=../knowledge
KNOWLEDGE_AUTO_SYNC=true
KB_TOP_K=4
KB_MIN_SCORE=3.0
KB_RELATIVE_CUTOFF=0.45
MAX_UPLOAD_MB=5

# Guardrail
GUARDRAIL_MAX_STRIKES=3
GUARDRAIL_SCORE_THRESHOLD=3
GUARDRAIL_LLM_CONFIDENCE=0.8
